set(revision "unknown")
set(source_state "unknown")
find_package(Git QUIET)
if(GIT_FOUND)
  execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${SOURCE_DIR}" rev-parse HEAD OUTPUT_VARIABLE revision OUTPUT_STRIP_TRAILING_WHITESPACE RESULT_VARIABLE git_result ERROR_QUIET)
  if(git_result EQUAL 0)
    execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${SOURCE_DIR}" status --porcelain --untracked-files=no OUTPUT_VARIABLE changes RESULT_VARIABLE status_result ERROR_QUIET)
    if(status_result EQUAL 0)
      if(changes STREQUAL "")
        set(source_state "clean")
      else()
        set(source_state "dirty")
      endif()
    endif()
  else()
    set(revision "unknown")
  endif()
endif()
set(content "#pragma once\n#define AX_BUILD_VERSION \"${VERSION}\"\n#define AX_BUILD_REVISION \"${revision}\"\n#define AX_BUILD_SOURCE_STATE \"${source_state}\"\n")
file(WRITE "${OUTPUT}.tmp" "${content}")
execute_process(COMMAND "${CMAKE_COMMAND}" -E copy_if_different "${OUTPUT}.tmp" "${OUTPUT}" COMMAND_ERROR_IS_FATAL ANY)
file(REMOVE "${OUTPUT}.tmp")
